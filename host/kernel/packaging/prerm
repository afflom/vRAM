#!/bin/sh
set -e
case "$1" in
remove|upgrade)
    if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
        systemctl stop vram-kernel.service
        systemctl disable vram-kernel.service
    fi
    if [ -d /var/lib/dkms/vram-fill/0.1.1 ]; then
        dkms remove -m vram-fill -v 0.1.1 --all
    fi
    ;;
esac
