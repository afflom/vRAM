[Unit]
Description=Verdant kernel-backed volatile swap
After=swap.target systemd-modules-load.service systemd-udevd.service
ConditionPathExists=/proc/swaps

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=VRAM_KERNEL_SIZE_MIB=auto
RuntimeDirectory=vram-kernel
EnvironmentFile=-/etc/default/vram
ExecCondition=/usr/lib/vram/kernel-plan --prepare
ExecStart=/usr/lib/vram/start-kernel-swap /run/vram-kernel/size
ExecStop=/sbin/swapoff /dev/vramfill0
ExecStop=/sbin/modprobe -r vram_fill
TimeoutStopSec=infinity

[Install]
WantedBy=multi-user.target
