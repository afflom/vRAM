#!/bin/sh
set -eu
# Only format a device this invocation created. An existing module may own live data.
if [ "$#" -eq 1 ]; then
    read -r size < "$1"
else
    size=$(/usr/lib/vram/kernel-plan)
fi
[ "$size" -gt 0 ] || exit 0
modprobe --first-time vram_fill "capacity_mib=$size"
trap 'modprobe -r vram_fill' EXIT
# Verify the device node belongs to the newly registered kernel disk.
node=/dev/vramfill0
tries=0
while [ ! -b "$node" ] && [ "$tries" -lt 300 ]; do
    sleep 0.1
    tries=$((tries + 1))
done
test -b "$node"
dev=$(cat /sys/block/vramfill0/dev)
test "$(stat -Lc '%t:%T' "$node")" = "$(printf '%x:%x' "${dev%:*}" "${dev#*:}")"
mkswap "$node"
swapon "$node"
expected=$((size * 1024 - 4))
while read -r path kind active used priority; do
    if [ "$path" = "$node" ] && [ "$active" = "$expected" ]; then
        trap - EXIT
        exit 0
    fi
done < /proc/swaps
echo "vRAM: Linux did not expose the expected $expected KiB on $node" >&2
swapoff "$node"
exit 1
