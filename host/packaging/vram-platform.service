[Unit]
Description=Publish the firmware memory ceiling for vRAM workstation users
ConditionPathExists=/sys/firmware/dmi/tables/DMI

[Service]
Type=oneshot
ExecStart=/usr/bin/vram-machine publish-platform
RuntimeDirectory=vram-platform
RuntimeDirectoryMode=0755
RemainAfterExit=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
